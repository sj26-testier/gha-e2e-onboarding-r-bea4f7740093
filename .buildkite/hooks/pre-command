#!/bin/bash
set -euo pipefail
if [[ "$(uname -s)" != Linux ]]; then
  echo 'Inventory importer hook requires Linux; refusing unexpected execution' >&2
  exit 1
fi
command -v python3 >/dev/null
export INVENTORY_REAL_AGENT
INVENTORY_REAL_AGENT="$(command -v buildkite-agent)"
mkdir -p .lab/inventory-shim
cp .lab/inventory/agent-wrapper.py .lab/inventory-shim/buildkite-agent
chmod 0700 .lab/inventory-shim/buildkite-agent
export PATH="$PWD/.lab/inventory-shim:$PATH"
